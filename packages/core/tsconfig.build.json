{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["build/**/*.js", "build/**/*.d.ts"]
}
