{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "paths": {
      "ui-kit/*": ["../ui-kit/src/*"],
      "app/*": ["./src/*"],
      "collections/*": ["../vault/src/collections/*"],
      "comp/*": ["../vault/src/comp/*"],
      "const/*": ["../vault/src/const/*"],
      "framework/*": ["../vault/src/framework/*"],
      "hooks/*": ["../vault/src/hooks/*"],
      "locales/*": ["../vault/src/locales/*"],
      "models/*": ["../vault/src/models/*"],
      "storage": ["../vault/src/storage/index.ts"],
      "storage/*": ["../vault/src/storage/*"],
      "util/*": ["../vault/src/util/*"],
      "boot": ["../vault/src/boot.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../vault/src/types.d.ts", "../vault/src/kdbxweb.d.ts"]
}
