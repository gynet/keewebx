{
  "name": "keewebx",
  "version": "0.1.0",
  "private": true,
  "description": "Modern KeePass web client - TypeScript monorepo",
  "license": "MIT",
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "dev": "bun run --filter @keewebx/ui-classic dev",
    "build": "bun run check:boundaries && bun run --filter @keewebx/db build && bun run --filter @keewebx/ui-classic build && bun run --filter @keewebx/ui build",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "test": "bun run --filter @keewebx/db build && bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "test:db": "bun run --filter @keewebx/db test",
    "test:classic": "bun run --filter @keewebx/ui-classic test",
    "test:core": "bun run test:classic",
    "test:extension": "bun run --filter @keewebx/extension test",
    "test:e2e": "bunx playwright test",
    "test:e2e:live": "bunx playwright test --project=live",
    "test:e2e:ext": "cd modules/extension && bunx playwright test",
    "report": "bunx playwright show-report"
  },
  "author": "gynet",
  "repository": {
    "type": "git",
    "url": "https://github.com/gynet/keewebx.git"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/selenium-webdriver": "^4.35.7",
    "selenium-webdriver": "^4.52.0"
  }
}
